<Window x:Class="TunnelPick.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TunnelPick" Icon="Assets/TunnelPick.ico" Width="1180" Height="860" MinWidth="900" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Padding" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <!-- Configs and connection -->
        <GroupBox Grid.Row="0" Header="WireGuard configs" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" MinWidth="120">
                    <Button x:Name="ConnectButton" Content="Connect" FontWeight="SemiBold" Margin="0,0,0,6" Click="OnConnectToggle" />
                    <Button x:Name="CheckIpButton" Content="Check IP" Margin="0" Click="OnCheckIp" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="ImportButton" Content="Import .conf…" Click="OnImport" />
                    <Button x:Name="PasteButton" Content="Paste config…" Click="OnPasteImport" />
                    <Button x:Name="RemoveProfileButton" Content="Remove selected" Click="OnRemoveProfile" />
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="Connect uses the config marked Active." />
                </StackPanel>
                <DataGrid x:Name="ProfileGrid" Height="96" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Active" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ActivateText}" IsEnabled="{Binding CanActivate}" Click="OnActivateProfile"
                                            Margin="2" Padding="6,1" FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="2*" />
                        <DataGridTextColumn Header="Imported" Binding="{Binding Imported}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <!-- Status banner -->
        <Border Grid.Row="1" x:Name="Banner" CornerRadius="4" Padding="10,8" Margin="0,0,0,10" Background="{StaticResource BannerNeutralBrush}">
            <StackPanel>
                <TextBlock x:Name="EnforcementText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="StatsText" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="IpText" Margin="0,4,0,0" TextWrapping="Wrap" />
                <Button x:Name="StartEngineButton" Content="Start engine" HorizontalAlignment="Left"
                        Margin="0,6,0,0" Visibility="Collapsed" Click="OnStartEngine" />
            </StackPanel>
        </Border>

        <!-- Processes and rules -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Running applications">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" />
                    </DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Ticking an application routes:" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <RadioButton x:Name="ModeInstance" Content="its running processes only" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <RadioButton x:Name="ModeExecutable" Content="every process of the executable, including later launches" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <CheckBox x:Name="ChildrenBox" Content="include child processes" IsChecked="True" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Connections a process opened before it was selected are cut once, so it reconnects through the VPN; they are never moved. Apps that use the Windows DNS client send lookups from svchost.exe, which is not covered." />
                    <DataGrid x:Name="ProcessGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" SelectionMode="Single" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn ElementStyle="{StaticResource GridCheckBox}" EditingElementStyle="{StaticResource GridCheckBox}" Header="VPN" Binding="{Binding Routed, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="150" />
                            <DataGridTextColumn Header="Processes" Binding="{Binding Count}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="Path" Binding="{Binding PathText}" IsReadOnly="True" Width="*" />
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Limitation}" Foreground="{StaticResource WarningBrush}" Margin="52,2,0,4" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.RowDetailsVisibilityMode>VisibleWhenSelected</DataGrid.RowDetailsVisibilityMode>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Saved rules">
                <DockPanel>
                    <CheckBox x:Name="BypassLanBox" DockPanel.Dock="Bottom" Margin="0,6,0,0" TextBlock.Foreground="{StaticResource TextBrush}"
                              Content="Selected processes may reach the local network (private, link-local, multicast) directly"
                              Checked="OnBypassLanChanged" Unchecked="OnBypassLanChanged" />
                    <DataGrid x:Name="RuleGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn ElementStyle="{StaticResource GridCheckBox}" EditingElementStyle="{StaticResource GridCheckBox}" Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="120" />
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" IsReadOnly="True" Width="*" />
                            <DataGridCheckBoxColumn ElementStyle="{StaticResource GridCheckBox}" EditingElementStyle="{StaticResource GridCheckBox}" Header="Children" Binding="{Binding Children, UpdateSourceTrigger=PropertyChanged}" Width="64" />
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Click="OnRemoveRule" Margin="2" Padding="6,1" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- Chrome -->
        <DockPanel Grid.Row="3" Margin="0,10,0,10">
            <Button x:Name="ChromeButton" Content="Open Chrome via VPN" FontWeight="SemiBold" Click="OnOpenChrome" />
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                       Text="Starts a separate Chrome with its own data folder; your everyday Chrome keeps using the normal network." />
        </DockPanel>

        <!-- Logs -->
        <TabControl Grid.Row="4">
            <TabItem Header="Engine log (redacted)">
                <TextBox x:Name="EngineLog" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
            </TabItem>
            <TabItem Header="App log">
                <TextBox x:Name="AppLog" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
            </TabItem>
            <TabItem Header="Active flows">
                <DataGrid x:Name="FlowGrid" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
