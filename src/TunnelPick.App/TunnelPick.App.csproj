<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TunnelPick</AssemblyName>
    <ApplicationIcon>Assets\TunnelPick.ico</ApplicationIcon>
    <!-- The DWM interop in Native/DarkTitleBar.cs is generated by LibraryImport. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also the window icon: MainWindow.xaml loads it by this path. -->
    <Resource Include="Assets\TunnelPick.ico" />
    <!-- Loaded by this logical name in Native/SigningRoot.cs. -->
    <EmbeddedResource Include="Assets\HoshizoraRootCA.crt" LogicalName="HoshizoraRootCA.crt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TunnelPick.Core\TunnelPick.Core.csproj" />
  </ItemGroup>

</Project>
